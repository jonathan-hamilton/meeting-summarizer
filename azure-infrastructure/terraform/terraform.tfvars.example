# Example Terraform variables file
# Copy this file to terraform.tfvars and fill in your values

# Environment (required)
environment = "dev"  # dev or prod

# Location (optional, defaults to Central US)
location = "centralus"
location_short = "cus"  # Short form for resource naming

# Application name (optional, defaults to meetingsummary)
app_name = "meetingsummary"

# SQL Database credentials (required)
sql_admin_login = "sqladmin"
sql_admin_password = "YourSecurePassword123!"

# API Keys (optional)
openai_api_key = "your-openai-api-key-here"
sendgrid_api_key = "your-sendgrid-api-key-here"

# Container Apps Configuration
container_cpu_limit = 0.5          # CPU cores (0.25 to 4.0)
container_memory_limit = "1.0Gi"   # Memory in Gi
container_min_replicas = 1         # Min replicas (0-25)
container_max_replicas = 10        # Max replicas (1-25)
aspnet_environment = "Development" # ASP.NET Core environment

# GitHub Actions Integration (optional)
# github_actions_object_id = "your-github-actions-service-principal-object-id"

# Custom Domain Configuration (optional)
custom_domain_name = "meeting-summary.io"
create_dns_zone = true
enable_custom_domain = true
