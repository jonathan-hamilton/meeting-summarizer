{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MeetingSummarizer.Api.Services.Configuration": "Debug"
    }
  },
  "Environment": {
    "Name": "Development",
    "DisplayName": "Local Development Environment",
    "IsProduction": false,
    "AllowTestFeatures": true,
    "FeatureFlags": {
      "EnableUserStorageTest": true,
      "EnableMockServices": true,
      "EnableDetailedErrorMessages": true
    }
  },
  "KeyVault": {
    "Enabled": false,
    "VaultUri": "https://your-keyvault.vault.azure.net/",
    "ClientId": "",
    "ClientSecret": "",
    "TenantId": ""
  },
  "Database": {
    "UseKeyVault": false,
    "KeyVaultSecretName": "DatabaseConnectionString-Dev",
    "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=MeetingSummarizerDev;Trusted_Connection=true;MultipleActiveResultSets=true",
    "Provider": "SqlServer",
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "CommandTimeout": 30,
    "MaxRetryCount": 3
  },
  "AzureStorage": {
    "UseKeyVault": false,
    "KeyVaultSecretName": "AzureStorageConnectionString",
    "ConnectionString": "UseDevelopmentStorage=true",
    "AccountName": "",
    "ContainerName": "audio-files",
    "UserDataContainer": "user-data",
    "TierManagement": {
      "CoolTierThresholdDays": 30,
      "ArchiveTierThresholdDays": 180,
      "AutoTierManagementEnabled": true
    }
  },
  "OpenAI": {
    "ApiKey": "",
    "DefaultChatModel": "gpt-4o-mini",
    "DefaultTranscriptionModel": "whisper-1",
    "BaseUrl": "https://api.openai.com/v1",
    "MaxRetries": 3,
    "RequestTimeoutSeconds": 120
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "info@vertec.solutions",
    "FromName": "Meeting-Summary.io"
  },
  "AzureSpeechServices": {
    "Key": "FSGJjTf1CzJCu0qHtFJdpna6T6bC6MuKp1bEMVAH7NaovPToxByfJQQJ99BHAC4f1cMXJ3w3AAAYACOGZAUm",
    "Endpoint": "https://westus.api.cognitive.microsoft.com/",
    "Region": "westus",
    "Language": "en-US",
    "EnableSpeakerDiarization": true,
    "RequestTimeoutSeconds": 120,
    "BatchTranscription": {
      "MinimumDurationForBatch": 30,
      "MaximumDurationSupported": 3600,
      "PollingIntervalSeconds": 10,
      "MaxPollingTimeoutSeconds": 900,
      "BaseDelayMilliseconds": 500,
      "MaxDelayMilliseconds": 15000,
      "EnableJobCleanup": true,
      "JobRetentionHours": 2
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:3001"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH" ],
    "AllowedHeaders": [ "Content-Type", "Authorization", "X-Requested-With" ],
    "AllowCredentials": true,
    "MaxAge": 3600
  }
}
