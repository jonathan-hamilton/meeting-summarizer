{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MeetingSummarizer.Api.Services.Configuration": "Information"
    }
  },
  "Environment": {
    "Name": "Staging",
    "DisplayName": "Development/Staging Environment",
    "IsProduction": false,
    "AllowTestFeatures": true
  },
  "KeyVault": {
    "Enabled": true,
    "VaultUri": "https://meetingsummary-dev-kv.vault.azure.net/",
    "ClientId": "",
    "ClientSecret": "",
    "TenantId": "",
    "UseManagedIdentity": true
  },
  "Database": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "DatabaseConnectionString-Dev",
    "ConnectionString": "",
    "Provider": "SqlServer",
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "CommandTimeout": 30,
    "MaxRetryCount": 3
  },
  "AzureStorage": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "AzureStorageConnectionString-Dev",
    "ConnectionString": "",
    "AccountName": "meetingsummarydev",
    "ContainerName": "audio-files",
    "UserDataContainer": "user-data",
    "TierManagement": {
      "CoolTierThresholdDays": 7,
      "ArchiveTierThresholdDays": 30,
      "AutoTierManagementEnabled": true
    }
  },
  "AzureSpeech": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "AzureSpeechKey-Dev",
    "SubscriptionKey": "",
    "Region": "eastus",
    "Endpoint": "https://meetingsummary-dev-speech.cognitiveservices.azure.com/"
  },
  "OpenAI": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "OpenAIApiKey-Dev",
    "ApiKey": "",
    "DefaultChatModel": "gpt-4o-mini",
    "DefaultTranscriptionModel": "whisper-1",
    "BaseUrl": "https://api.openai.com/v1",
    "MaxRetries": 3,
    "RequestTimeoutSeconds": 120
  },
  "SendGrid": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "SendGridApiKey-Dev",
    "ApiKey": "",
    "FromEmail": "dev@meetingsummary.io",
    "FromName": "Meeting Summary [DEV]"
  },
  "ApplicationInsights": {
    "ConnectionString": "",
    "InstrumentationKey": "",
    "EnableDependencyTracking": true,
    "EnablePerformanceCounters": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://dev.meetingsummary.io",
      "https://meetingsummary-dev-web.azurestaticapps.net",
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  }
}
