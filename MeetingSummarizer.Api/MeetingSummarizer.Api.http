@MeetingSummarizer.Api_HostAddress = http://localhost:5029
@auth_token = YOUR_JWT_TOKEN_HERE

### 0. Register Test User (run this first)
POST {{MeetingSummarizer.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "TestPassword123!",
  "firstName": "Test",
  "lastName": "User"
}

### 0b. Login Test User (run this to get JWT token, copy accessToken for @auth_token)
# @name login
POST {{MeetingSummarizer.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "TestPassword123!"
}

### Weather Test
GET {{MeetingSummarizer.Api_HostAddress}}/weatherforecast/
Accept: application/json

### 1. Create Payment Intent ✅ WORKING
POST {{MeetingSummarizer.Api_HostAddress}}/api/payments/create-intent
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "email": "test@example.com",
  "amount": 10.00,
  "tokenCount": 100,
  "userId": "temp"
}

### 2. Get Payment Details ✅ WORKING (replace with actual payment intent ID from step 1)
GET {{MeetingSummarizer.Api_HostAddress}}/api/payments/pi_test_1234567890
Authorization: Bearer {{auth_token}}

### 3. Confirm Payment (replace with actual payment intent ID and payment method)
POST {{MeetingSummarizer.Api_HostAddress}}/api/payments/confirm
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{

### 4. Get Batch Job Status ✅ (replace with your job ID)
GET {{MeetingSummarizer.Api_HostAddress}}/api/batchjob/e89f1cda-cb86-4766-99ba-4b6e115ee01e/status
Authorization: Bearer {{auth_token}}

### 5. List All Batch Jobs for User
GET {{MeetingSummarizer.Api_HostAddress}}/api/batchjob
Authorization: Bearer {{auth_token}}

### 6. Cancel Batch Job (if needed)
DELETE {{MeetingSummarizer.Api_HostAddress}}/api/batchjob/e89f1cda-cb86-4766-99ba-4b6e115ee01e
Authorization: Bearer {{auth_token}}

{
  "paymentIntentId": "pi_test_1234567890",
  "paymentMethodId": "pm_card_visa"
}

### 4. Webhook Health Check ✅ WORKING
GET {{MeetingSummarizer.Api_HostAddress}}/api/webhooks/stripe/health

### 5. Test Stripe Webhook (⚠️ Needs ngrok for real testing)
POST {{MeetingSummarizer.Api_HostAddress}}/api/webhooks/stripe
Content-Type: application/json
stripe-signature: t=1640995200,v1=test_signature

{
  "id": "evt_test_webhook",
  "object": "event",
  "type": "payment_intent.succeeded",
  "data": {
    "object": {
      "id": "pi_test_1234567890",
      "object": "payment_intent",
      "amount": 1000,
      "currency": "usd",
      "status": "succeeded"
    }
  }
}

### === EMAIL VERIFICATION ENDPOINTS (S6.8) ===

### 7. Register Test User with Email Verification (NEW - now sends verification email)
POST {{MeetingSummarizer.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "verification-test@example.com",
  "password": "TestPassword123!",
  "firstName": "Verification",
  "lastName": "Test",
  "hasConsentedToDataProcessing": true
}

### 8. Get Email Verification Status
GET {{MeetingSummarizer.Api_HostAddress}}/api/emailverification/status
Authorization: Bearer {{auth_token}}

### 9. Resend Verification Email  
POST {{MeetingSummarizer.Api_HostAddress}}/api/emailverification/resend
Authorization: Bearer {{auth_token}}

### 10. Verify Email with Token (replace TOKEN_HERE with actual verification token from email)
POST {{MeetingSummarizer.Api_HostAddress}}/api/emailverification/verify/TOKEN_HERE

### 11. Invalidate Current Verification Token
DELETE {{MeetingSummarizer.Api_HostAddress}}/api/emailverification/token
Authorization: Bearer {{auth_token}}

### === FEATURE GATING TESTS (S6.8 Increment 4) ===

### 12. Test Blocked Feature - Transcribe Audio (should fail for unverified users)
POST {{MeetingSummarizer.Api_HostAddress}}/api/summary/transcribe
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{auth_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="audioFile"; filename="test.mp3"
Content-Type: audio/mpeg

< ./test-audio.mp3
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 13. Test Blocked Feature - Token Purchase (should fail for unverified users)
POST {{MeetingSummarizer.Api_HostAddress}}/api/token/purchase/initiate
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "tokenAmount": 100,
  "paymentAmount": 10.00
}

### 14. Test Blocked Feature - Save Summary (should fail for unverified users)
POST {{MeetingSummarizer.Api_HostAddress}}/api/savedsummary/user/{{userId}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "title": "Test Summary",
  "summary": "This is a test summary",
  "transcriptionId": "test-123"
}

