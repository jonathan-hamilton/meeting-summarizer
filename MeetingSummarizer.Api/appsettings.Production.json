{
  "Frontend": {
    "BaseUrl": "https://meeting-summary.io"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "MeetingSummarizer.Api": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Environment": {
    "Name": "Production",
    "DisplayName": "Production Environment",
    "IsProduction": true,
    "AllowTestFeatures": false
  },
  "KeyVault": {
    "Enabled": true,
    "VaultUri": "https://meetingsummary-prod-kv.vault.azure.net/",
    "ClientId": "",
    "ClientSecret": "",
    "TenantId": "",
    "UseManagedIdentity": true
  },
  "Database": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "DatabaseConnectionString-Prod",
    "ConnectionString": "",
    "Provider": "SqlServer",
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false,
    "CommandTimeout": 60,
    "MaxRetryCount": 5
  },
  "AzureStorage": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "AzureStorageConnectionString-Prod",
    "ConnectionString": "",
    "AccountName": "meetingsummaryprod",
    "ContainerName": "audio-files",
    "UserDataContainer": "user-data",
    "TierManagement": {
      "CoolTierThresholdDays": 30,
      "ArchiveTierThresholdDays": 180,
      "AutoTierManagementEnabled": true
    }
  },
  "AzureSpeech": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "AzureSpeechKey-Prod",
    "SubscriptionKey": "",
    "Region": "eastus",
    "Endpoint": "https://meetingsummary-prod-speech.cognitiveservices.azure.com/"
  },
  "OpenAI": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "OpenAIApiKey-Prod",
    "ApiKey": "",
    "DefaultChatModel": "gpt-4o",
    "DefaultTranscriptionModel": "whisper-1",
    "BaseUrl": "https://api.openai.com/v1",
    "MaxRetries": 5,
    "RequestTimeoutSeconds": 180,
    "EnableSpeakerDiarization": true
  },
  "SendGrid": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "SendGridApiKey-Prod",
    "ApiKey": "",
    "FromEmail": "support@meetingsummary.io",
    "FromName": "Meeting Summary"
  },
  "Stripe": {
    "UseKeyVault": true,
    "SecretKeyVaultName": "StripeSecretKey-Prod",
    "PublishableKeyVaultName": "StripePublishableKey-Prod", 
    "WebhookSecretVaultName": "StripeWebhookSecret-Prod",
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "IsTestMode": false
  },
  "ApplicationInsights": {
    "ConnectionString": "",
    "InstrumentationKey": "",
    "EnableDependencyTracking": true,
    "EnablePerformanceCounters": true,
    "EnableSqlCommandTextInstrumentation": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://meetingsummary.io",
      "https://app.meetingsummary.io",
      "https://meetingsummary-prod-web.azurestaticapps.net"
    ]
  },
  "FileUpload": {
    "MaxFileSizeBytes": 1073741824,
    "AllowedExtensions": [ ".mp3", ".wav", ".m4a", ".flac", ".ogg" ],
    "UploadPath": "uploads/"
  },
  "TranscriptionService": {
    "PreferredProvider": "AzureSpeech",
    "FallbackToMock": false,
    "EnableDetailedLogging": false
  }
}
