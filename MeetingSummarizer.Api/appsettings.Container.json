{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MeetingSummarizer.Api.Services.Configuration": "Debug"
    }
  },
  "Environment": {
    "Name": "Container",
    "DisplayName": "Container Environment", 
    "IsProduction": false,
    "AllowTestFeatures": true,
    "FeatureFlags": {
      "EnableUserStorageTest": true,
      "EnableMockServices": false,
      "EnableDetailedErrorMessages": true,
      "RequireInvitationForRegistration": true
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:8080"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8080"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["*"],
    "AllowCredentials": true,
    "MaxAge": 300
  },
  "KeyVault": {
    "Enabled": true,
    "VaultUri": "https://msio-dev-v2-kv.vault.azure.net/",
    "UseManagedIdentity": false,
    "ClientId": "5ed62488-7c1f-42bf-b855-d501d84f1f7c",
    "ClientSecret": null,
    "TenantId": "1c30d7a8-9627-4b0c-b799-12bae25a849b",
    "UseEnvironmentVariable": true
  },
  "Database": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "DatabaseConnectionString-Dev",
    "ConnectionString": "",
    "Provider": "SqlServer",
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": true,
    "CommandTimeout": 30,
    "MaxRetryCount": 3
  },
  "AzureStorage": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "AzureStorageConnectionString-Dev",
    "ConnectionString": "",
    "AccountName": "",
    "ContainerName": "audio-files",
    "UserDataContainer": "user-data",
    "UseConnectionString": true,
    "SasTokenUrl": "",
    "BlobServiceOptions": {
      "RetryPolicy": {
        "MaxRetries": 3,
        "DelayBetweenRetriesInSeconds": 2
      }
    }
  },
  "OpenAI": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "OpenAI--ApiKey",
    "ApiKey": "",
    "DefaultChatModel": "gpt-4o-mini",
    "DefaultTranscriptionModel": "whisper-1",
    "BaseUrl": "https://api.openai.com/v1",
    "MaxTokens": 4000,
    "Temperature": 0.3,
    "RequestTimeoutSeconds": 120,
    "MaxRetries": 3,
    "RetryDelaySeconds": 1,
    "EnableLogging": true,
    "EnableTokenUsageTracking": true,
    "EnableRateLimitHandling": true,
    "EnableCostTracking": true
  },
  "SendGrid": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "SendGrid--ApiKey",
    "ApiKey": "",
    "FromEmail": "jhamilton.swe@gmail.com",
    "FromName": "Meeting Summary"
  },
  "AzureSpeechServices": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "AzureSpeechServices--Key",
    "Key": "",
    "Endpoint": "",
    "Region": "westus",
    "Language": "en-US",
    "EnableSpeakerDiarization": true,
    "RequestTimeoutSeconds": 120,
    "BatchTranscription": {
      "MinimumDurationForBatch": 30,
      "MaximumDurationSupported": 3600,
      "PollingIntervalSeconds": 10,
      "MaxPollingTimeoutSeconds": 900,
      "EnablePunctuationAndFormatting": true,
      "EnableProfanityFilter": false
    }
  },
  "Stripe": {
    "UseKeyVault": true,
    "SecretKeyVaultName": "Stripe--SecretKey",
    "PublishableKeyVaultName": "Stripe--PublishableKey",
    "WebhookSecretVaultName": "Stripe--WebhookSecret",
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "IsTestMode": true
  },
  "JWT": {
    "UseKeyVault": true,
    "KeyVaultSecretName": "JWT--SecretKey",
    "SecretKey": "",
    "Issuer": "MeetingSummary.io",
    "Audience": "MeetingSummary.io",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  }
}